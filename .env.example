# ============================================================
# Bad Ass Tasks — Environment Configuration
#
# Copy this file to .env.local and fill in your values.
#
# For pure demo mode (no Supabase needed):
#   - Leave these blank or do not create .env.local
#
# For Milestone 1 (Live Supabase):
#   - Create a project at https://supabase.com
#   - Paste your Project URL and anon key below
#   - Then run the activation SQL from docs/MILESTONE-1-SUPABASE-ACTIVATION.md
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: If you later add a service role key for admin scripts (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Brevo transactional email (server-only — never use NEXT_PUBLIC_ prefix)
# Create API key at: Brevo → Settings → SMTP & API → API keys & MCP
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_EMAIL=alert@badazztasks.com
BREVO_SENDER_NAME=Badazz Tasks
APP_BASE_URL=http://localhost:3000
# Production: APP_BASE_URL=https://badazztasks.com
