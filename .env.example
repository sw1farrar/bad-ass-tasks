# ============================================================
# Bad Ass Tasks — Environment Configuration
#
# Copy this file to .env.local and fill in your values.
#
# For pure demo mode (no Supabase needed):
#   - Leave these blank or do not create .env.local
#
# For Milestone 1 (Live Supabase):
#   - Create a project at https://supabase.com
#   - Paste your Project URL and anon key below
#   - Then run the activation SQL from docs/MILESTONE-1-SUPABASE-ACTIVATION.md
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Required for signup email verification (server-only — never use NEXT_PUBLIC_ prefix)
# Supabase → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Brevo transactional email (server-only — never use NEXT_PUBLIC_ prefix)
# Create API key at: Brevo → Settings → SMTP & API → API keys & MCP
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_SENDER_EMAIL=alert@badazztasks.com
BREVO_SENDER_NAME=Badazz Tasks
APP_BASE_URL=http://localhost:3000
# Production: APP_BASE_URL=https://badazztasks.com

# Brevo inbound parsing (note-from-email)
BREVO_INBOUND_DOMAIN=inbound.badazztasks.com
# Optional: require x-brevo-inbound-secret header or ?secret= on webhook POST
# BREVO_INBOUND_WEBHOOK_SECRET=generate-a-long-random-string-here
# After deploy: run supabase/add-note-attachments.sql for file storage + idempotency tables

# Optional: dedicated secret for dual-auth cookies + OTP hashing (recommended in production).
# If omitted, a derived key from SUPABASE_SERVICE_ROLE_KEY is used instead.
# DUAL_AUTH_SECRET=generate-a-long-random-string-here

# Grok custom connector (MCP + OAuth). After deploy:
#   1. Run supabase/add-mcp-oauth.sql
#   2. At https://grok.com/connectors → New Connector → Custom
#      Name: Badazz Tasks
#      Server URL: https://badazztasks.com/api/mcp
# Signing secret: 32+ random chars. If omitted, derived from SUPABASE_SERVICE_ROLE_KEY.
# MCP_OAUTH_SECRET=generate-a-long-random-string-at-least-32-chars
# Optional origin override (defaults to APP_BASE_URL)
# MCP_RESOURCE_URL=https://badazztasks.com

# Platform admin dashboard (comma-separated emails; server-only)
# SITE_ADMIN_EMAILS=you@example.com,ops@example.com

# ============================================================
# Mapbox (Maps feature — territories + stores)
# Get a token at https://account.mapbox.com/access-tokens/
# Required when a workspace has Maps enabled (settings → Map)
# ============================================================
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

# Maps DB migration (run once on Supabase after pulling Maps feature code):
#   supabase/add-maps-territories-stores.sql
# Or: node scripts/apply-supabase-sql.mjs supabase/add-maps-territories-stores.sql
# If PostGIS was previously installed in public (Security Advisor RLS email):
#   node scripts/apply-supabase-sql.mjs supabase/move-postgis-to-extensions.sql

# ============================================================
# xAI / Grok — PASTE YOUR API KEY ON THE NEXT LINE
# ============================================================
# 1. Open https://console.x.ai/
# 2. API Keys → Create key
# 3. Replace PASTE_YOUR_XAI_KEY_HERE below (key usually starts with xai-)
# 4. Save this file, then RESTART the dev server
#
# Powers: Files → Review file → "AI name" button
# ============================================================
XAI_API_KEY=PASTE_YOUR_XAI_KEY_HERE
# Optional model override (default: grok-4.3)
# XAI_MODEL=grok-4.3
# Force sim/offline AI (disables Grok even when a key is set)
# AI_FORCE_SIM=1

# ============================================================
# Database migrations (existing Supabase projects)
# Run in Supabase SQL Editor after pulling new app code:
#   1. supabase/sync-all-features.sql   (M2 notes, lists, dual-auth, admin pause)
#   2. supabase/fix-invite-lifecycle-rls-and-rpcs.sql  (exit_workspace, invite cleanup)
# Verify: supabase/verify-schema.sql (all rows should be OK)
# Site admin API check: GET /api/health/database (when signed in as site admin)
#
# Apply missing migrations from terminal (needs one of):
#   SUPABASE_ACCESS_TOKEN=...  (dashboard → Account → Access Tokens)
#   DATABASE_URL=postgresql://postgres.[ref]:[password]@...
# Then: node scripts/apply-supabase-sql.mjs supabase/apply-missing-on-live.sql
# ============================================================
